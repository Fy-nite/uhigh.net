{
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Launch μHigh Compiler",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/bin/Debug/net9.0/uhigh.dll", 
            "args": [
                "Examples/array.uh",
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "stopAtEntry": true
        },
        {
            "name": "Attach to μHigh by Process Name",
            "type": "coreclr",
            "request": "attach",
            "processName": "uhigh" 
        }
    ]
}